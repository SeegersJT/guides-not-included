{
	"hosting": {
		"public": "dist",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	},
	"firestore": {
		"database": "(default)",
		"location": "africa-south1"
	},
	"auth": {
		"providers": {
			"emailPassword": true,
			"googleSignIn": {
				"oAuthBrandDisplayName": "Guides Not Included",
				"supportEmail": "support@undefined.firebaseapp.com"
			}
		}
	}
}
